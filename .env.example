# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Reverse proxies in front of this service whose X-Forwarded-For is trusted for
# client IPs (rate limits, blocks). 0 uses the socket peer address.
TRUSTED_PROXIES=0
# A header holding the client's address, set by a proxy that overwrites it on every
# request (x-real-ip on Railway). It wins over TRUSTED_PROXIES when it holds an IP.
# Leave empty unless such a proxy is in front: a caller could otherwise set it.
CLIENT_IP_HEADER=

# WhatsApp Cloud API (Meta). Leave the token or phone number id empty to run in
# dry-run mode: replies are logged instead of sent.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Deliveries naming another business account or phone number id are dropped.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Messages older than this many seconds are dropped as stale or replayed (24 h)
WEBHOOK_MAX_MESSAGE_AGE_SECONDS=86400
WHATSAPP_GRAPH_API_VERSION=v26.0

# WhatsApp Flows (forms for onboarding, PIN approval, fund/withdraw/buy). Each Flow
# is used on WhatsApp once its id is set; without one, the chat steps are used.
# Set up with: bun run flows keys | upload-key | sync https://<host>/flows
# The endpoint's RSA private key (PEM; literal \n line breaks work). A secret.
WHATSAPP_FLOW_PRIVATE_KEY=
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
WHATSAPP_FLOW_ID_ONBOARDING=
WHATSAPP_FLOW_ID_PIN=
WHATSAPP_FLOW_ID_TRANSACTION=
# draft sends Flows that aren't published yet (testing); published otherwise
WHATSAPP_FLOW_MODE=published

# Storage: three SQLite files under this directory (app data, sessions, job queue)
DATA_DIR=./data

# Apply pending database migrations at startup (default: on outside production).
# Off, a pending migration refuses the start: run `bun run db:migrate` first.
MIGRATE_ON_START=

# Idle time before an unfinished conversation resets, in milliseconds (24 h)
SESSION_TTL_MS=86400000

# Admin area (/admin, jobs dashboard at /admin/jobs). When all three are set, this
# admin is created at startup, or has its password reset to this value. The password
# needs 12+ characters mixing three of: lower case, upper case, digits, symbols.
# Or create admins with: bun run admin:create
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# How long an admin stays signed in, in milliseconds (8 h)
ADMIN_SESSION_TTL_MS=28800000

# Enables POST /dev/simulate to chat with the bot without WhatsApp. Never in production.
ENABLE_DEV_ROUTES=true
# Offer the Flows in the chat simulator, which renders them itself (no Meta setup)
SIMULATOR_FLOWS=true
